#!/usr/bin/env bash
#
# ct -- run a local OpenTelemetry + Jaeger stack and point Claude Code at it.
#
#   ./ct up        fetch pinned binaries, start the stack, wait until it answers
#   ./ct claude    run claude here, traced, labelled with the work it is doing
#   ./ct sql       query a year of spans:  ./ct sql 'SELECT count() FROM claude.spans'
#   ./ct env       print the exports that make Claude Code emit spans
#   ./ct verify    prove end to end that a Claude session reaches every sink
#   ./ct status    what is running, and is it answering
#   ./ct logs      tail the service logs
#   ./ct ui        open the Jaeger UI
#   ./ct down      stop the stack

set -euo pipefail

CT_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$CT_SELF_DIR/lib/common.sh"
. "$CT_SELF_DIR/lib/tools.sh"
. "$CT_SELF_DIR/lib/labels.sh"

READY_TIMEOUT_SECONDS=30
# ClickHouse flushes and closes its parts on the way down, so it is the service
# that sets this floor; the other two exit near-instantly.
STOP_TIMEOUT_SECONDS=30
# How long a span may take to cross the collector's batch window and land in a
# sink. Claude exports every 5s and the collector batches for 2 more.
SINK_TIMEOUT_SECONDS=30
SELFTEST_SERVICE=claude-tracing-selftest

# Claude Code's own resource service.name. cmd_env deliberately does not set
# OTEL_SERVICE_NAME, so this is the name spans arrive under -- and cmd_env is why
# that is true, which is what keeps this constant honest rather than a guess.
CLAUDE_SERVICE_NAME=claude-code

# --- service lifecycle ------------------------------------------------------
# Every function below operates on a row of ct_services(). There is no
# per-service code path anywhere in this file.

# A failing probe is this function's return value, not an error to report: the
# caller polls it, and ct_await_ready is what speaks up when the polling runs
# out. Hence -fs (quiet on failure) rather than -fsS.
ct_probe() { curl -fs --max-time 2 -o /dev/null "$1"; }

# One query, posted rather than URL-encoded, so a query containing anything at
# all -- quotes, newlines, percent signs -- reaches ClickHouse as written.
ct_clickhouse() {
  curl -fsS --max-time 30 "http://127.0.0.1:$CT_CLICKHOUSE_HTTP_PORT/" --data-binary "$1"
}

# Blocks until the service answers its readiness URL, or dies with the tail of
# its own log. [LAW:no-ambient-temporal-coupling] the gate is the condition we
# actually depend on -- the query API answering, the span table existing --
# never an elapsed sleep.
ct_await_ready() {
  local name="$1" url="$2"
  ct_poll_until "$READY_TIMEOUT_SECONDS" ct_probe "$url" && return 0
  ct_warn "--- last 20 lines of $(ct_logfile "$name") ---"
  tail -n 20 "$(ct_logfile "$name")" >&2
  ct_die "$name did not become ready at $url within ${READY_TIMEOUT_SECONDS}s"
}

# Handler over a service row: name, readiness URL, then the command to run.
ct_start_service() {
  local name="$1" ready="$2" bin="$3" pid
  shift 2
  pid="$(ct_pid_of "$name")"
  if [ -n "$pid" ]; then
    ct_info "$name already running (pid $pid)"
    return 0
  fi
  [ -x "$bin" ] || ct_die "$name binary missing at $bin -- run './ct up'"

  # [LAW:single-enforcer] One rule for both daemons: a service in this stack never
  # exports its own telemetry into the stack. Jaeger self-traces to localhost:4317
  # by default, and a shell that has sourced `./ct env` would hand both services
  # the exporter contract meant for Claude. Either way you get the stack's own
  # chatter stored beside your Claude traces. Neutralised once, here.
  # BSD env insists every -u precede the first NAME=VALUE; GNU env accepts both.
  nohup env \
    -u OTEL_EXPORTER_OTLP_ENDPOINT -u OTEL_EXPORTER_OTLP_PROTOCOL \
    -u OTEL_EXPORTER_OTLP_HEADERS -u CLAUDE_CODE_ENABLE_TELEMETRY \
    OTEL_TRACES_EXPORTER=none \
    "$@" >>"$(ct_logfile "$name")" 2>&1 &
  printf '%s\n' "$!" > "$(ct_pidfile "$name")"
  ct_await_ready "$name" "$ready"
  ct_ok "$name ready (pid $(cat "$(ct_pidfile "$name")"))"
}

ct_process_gone() { ! kill -0 "$1" 2>/dev/null; }

ct_stop_service() {
  local name="$1" pid
  pid="$(ct_pid_of "$name")"
  rm -f "$(ct_pidfile "$name")"
  if [ -z "$pid" ]; then
    ct_info "$name not running"
    return 0
  fi
  kill "$pid"
  ct_poll_until "$STOP_TIMEOUT_SECONDS" ct_process_gone "$pid" \
    || ct_die "$name (pid $pid) ignored SIGTERM for ${STOP_TIMEOUT_SECONDS}s"
  ct_ok "$name stopped"
}

ct_report_service() {
  local name="$1" ready="$2" pid state
  pid="$(ct_pid_of "$name")"
  state="stopped"
  if [ -n "$pid" ]; then
    state="running (pid $pid), not answering $ready"
    if ct_probe "$ready"; then state="ready (pid $pid)"; fi
  fi
  printf '%-11s %s\n' "$name" "$state"
}

# --- subcommands ------------------------------------------------------------

cmd_up() {
  mkdir -p "$CT_BIN_DIR" "$CT_RUN_DIR" "$CT_LOG_DIR" "$CT_VAR_DIR/jaeger" \
           "$CT_CLICKHOUSE_DATA_DIR"
  ct_install_tools
  ct_for_each_service ct_start_service
  echo
  ct_ok "Jaeger UI  http://127.0.0.1:$CT_JAEGER_UI_PORT"
  ct_info "OTLP in    127.0.0.1:$CT_OTLP_GRPC_PORT (gRPC)  127.0.0.1:$CT_OTLP_HTTP_PORT (HTTP)"
  ct_info "SQL        ./ct sql 'SELECT count() FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE'"
  ct_info "Metrics    http://127.0.0.1:$CT_CLAUDE_METRICS_PORT/metrics"
  ct_info "Events     $CT_LOG_DIR/claude-events.jsonl"
  echo
  ct_trace "Next:  cd to the repo you want to trace, then:  $CT_ROOT/ct claude"
}

cmd_down()   { ct_for_each_service ct_stop_service; }
cmd_status() { ct_for_each_service ct_report_service; }

# Ad-hoc SQL against the year of spans -- the seam every analytical question
# goes through, so nothing downstream has to learn ClickHouse's wire protocol.
#
# [LAW:dataflow-not-control-flow] The query is passed through untouched and the
# answer goes to stdout in ClickHouse's default TabSeparated, so `./ct sql ... |
# cut -f2` composes. Output shape is a value the caller supplies -- `FORMAT
# PrettyCompact` to read, `FORMAT JSON` to parse -- rather than a mode this
# command picks by sniffing whether stdout is a terminal. One code path, and the
# answer does not change shape depending on who is watching.
cmd_sql() {
  local query="$*"
  [ -n "$query" ] || ct_die "usage: ct sql <query>
  e.g.  ./ct sql \"SELECT SpanType, count() FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE GROUP BY 1 FORMAT PrettyCompact\""
  ct_clickhouse "$query" || ct_die "ClickHouse rejected the query, or is not up. Check: ./ct status"
}

cmd_logs() {
  tail -n 40 -F "$CT_LOG_DIR"/*.log
}

cmd_ui() {
  open "http://127.0.0.1:$CT_JAEGER_UI_PORT"
}

# The exporter contract, generated from the same constants the stack binds to,
# so the endpoint Claude is told about cannot drift from the one that is
# listening. Emitted as data -- source it, paste it into ~/.claude/settings.json,
# or wrap it in a launcher; that choice is the caller's.
cmd_env() {
  cat <<EOF
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_TRACES_EXPORTER=otlp
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:$CT_OTLP_GRPC_PORT
export OTEL_TRACES_EXPORT_INTERVAL=5000
export OTEL_LOGS_EXPORT_INTERVAL=5000
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_TOOL_DETAILS=1
export OTEL_METRICS_INCLUDE_SESSION_ID=true
EOF
}

# The launcher: one claude run, carrying both halves of the contract -- the
# transport from cmd_env, and labels for the work it is about to do.
#
# [LAW:no-ambient-temporal-coupling] The labels are computed here, at exec time,
# from the directory you are actually standing in. That timing is the reason this
# command exists rather than a few more lines in cmd_env: work-unit labels
# sourced once into a shell would go on claiming the repo you were in when you
# sourced them, long after you had cd'd somewhere else. So cmd_env stays
# transport-only and this owns the labels -- one fact, one authority.
# [LAW:one-source-of-truth]
cmd_claude() {
  local attributes
  command -v claude >/dev/null || ct_die "'claude' is not on PATH"
  attributes="$(ct_resource_attributes "${OTEL_RESOURCE_ATTRIBUTES:-}")"

  # Stdout belongs to claude -- `./ct claude -p ... | jq` has to keep working --
  # so what we stamped is reported on stderr. Reported rather than assumed: a
  # run outside a git checkout is legitimately labelled with less, and seeing
  # that at the moment it happens beats inferring it from a query months later.
  ct_trace "labels: $attributes" >&2

  eval "$(cmd_env)"
  export OTEL_RESOURCE_ATTRIBUTES="$attributes"
  exec claude "$@"
}

# --- verification -----------------------------------------------------------
# [LAW:verifiable-goals] "the stack is up" is not the goal; "this run's telemetry
# is queryable in every sink the stack claims to have, and you can tell what work
# it was doing" is. All three stages run every time, cheapest first, each
# isolating one thing: the label encoding, then the transport, then the thing you
# actually came for.
#
# A sink outside this definition of done has nothing holding it up, so it rots
# and nobody is told -- which is how the metrics endpoint answered HTTP 200 with
# an empty body for hours while verify went green. The defence is structural
# rather than diligent: one sink table, one enforcer, and a new sink is a row in
# it. A check bolted on beside the table would drift the same way the sinks did.
# [LAW:single-enforcer]

# [LAW:behavior-not-structure] What a value encodes to, not how it gets there --
# a different encoder passing all of these would be just as correct.
#
# Fields: value|expected encoding
ct_encoding_cases() {
  cat <<'EOF'
feat/some-branch|feat/some-branch
/usr/local/bin|/usr/local/bin
a b|a%20b
a,b|a%2Cb
k=v|k%3Dv
café|caf%C3%A9
50%|50%25
EOF
}

# Runs first because it costs milliseconds and nothing downstream means anything
# if it fails: an attribute string that loses to one stray character produces a
# session that looks labelled and carries nothing.
verify_labels() {
  local value expected actual root sandbox
  ct_info "stage 1/3: label encoding (pure, no network)"

  while IFS='|' read -r value expected; do
    actual="$(ct_percent_encode "$value")"
    [ "$actual" = "$expected" ] \
      || ct_die "encoding '$value' gave '$actual', expected '$expected'"
  done < <(ct_encoding_cases)

  # A session with less to say, for real rather than by mock: no git checkout,
  # and a path carrying the exact character measured to destroy a whole
  # attribute set. Checking mktemp answered is about the rm below, not the test.
  root="$(mktemp -d)"
  [ -d "$root" ] || ct_die "mktemp -d produced no directory"
  sandbox="$root/a b"
  mkdir -p "$sandbox"
  actual="$(cd "$sandbox" && ct_work_labels)"
  rm -rf "$root"

  [ "$actual" = "process.working_directory=$(ct_percent_encode "$sandbox")" ] \
    || ct_die "outside a git checkout, the labels should be the working directory
  alone and encoded. Got: $actual"

  ct_ok "  encoding holds, and a directory with no repo drops the vcs labels"
}

# --- a run, and the four places it has to land ------------------------------
# A probe run is two values: the service its telemetry arrives under, and a
# needle -- one string, stamped as `session.id` on everything the run emits.
#
# That stamp is what lets four unlike sinks be asked one question, because
# session.id is the key all four already index on: a Jaeger tag, a promoted
# ClickHouse column, a Prometheus label, an attribute on every event record.
# Without it each sink would need its own notion of "this run", and four notions
# is how the sinks drifted apart in the first place. [LAW:one-source-of-truth]

# A uuid, because `claude --session-id` takes one and Claude Code then stamps it
# on every span, metric and event of the session -- so the needle is known before
# the run rather than recovered from a payload afterwards. Lowercased because
# every sink compares it exactly and macOS uuidgen answers in upper case.
ct_uuid() { uuidgen | tr '[:upper:]' '[:lower:]'; }

# True when running the given command produces output containing the needle.
#
# The body is captured whole rather than piped into grep, and that is the point:
# `grep -q` closes the pipe on its first match, the producer still writing dies of
# SIGPIPE, and under `set -o pipefail` a *found* needle comes back as a failed
# pipeline. A check that goes red at random is a check nobody believes, so the
# pipe is removed rather than the flake tolerated.
ct_output_holds() {
  local needle="$1" body
  shift
  body="$("$@")" || return 1
  case "$body" in *"$needle"*) return 0 ;; esac
  return 1
}

# A failing probe is a return value here, not an error to report -- the caller
# polls it, and the sink enforcer is what speaks up when the polling runs out.
# Hence -fs (quiet on failure), the same trade ct_probe makes.
jaeger_api() { curl -fs --max-time 5 "http://127.0.0.1:$CT_JAEGER_UI_PORT/api/$1"; }

# Jaeger's tag search takes a JSON object of tag/value pairs, ANDed together, and
# matches them against a span's own attributes and its resource attributes alike
# -- which is why one query below can name both the session (a span attribute)
# and the work-unit labels (resource attributes).
json_escape()   { local v="${1//\\/\\\\}"; printf '%s' "${v//\"/\\\"}"; }
jaeger_tag_of() { printf '"%s":"%s"' "$(json_escape "$1")" "$(json_escape "$2")"; }
jaeger_traces_tagged() {
  local service="$1" tags="$2"
  jaeger_api "traces?service=$service&lookback=1h&tags=$(ct_percent_encode "{$tags}")"
}

# True when the query returns any row at all, so the query must select rows and
# not count them: an aggregate answers '0' to a question with no matches, which
# is a non-empty answer meaning nothing arrived -- exactly the answer-shaped void
# this is here to catch. [LAW:parse-dont-validate]
clickhouse_returns_a_row() {
  local rows
  rows="$(ct_clickhouse "$1")" || return 1
  [ -n "$rows" ]
}

# Each of these answers one question -- is this run's data in my sink yet -- and
# each takes the whole run and uses the part it needs, the way a service-row
# handler does. They assert the property their sink exists for, never that it is
# merely reachable: a scrape that returns HTTP 200 with an empty body is the
# original defect, and "the endpoint answered" would have called it healthy.
jaeger_has_run() {
  ct_output_holds "$2" jaeger_traces_tagged "$1" "$(jaeger_tag_of session.id "$2")"
}

clickhouse_has_run() {
  clickhouse_returns_a_row \
    "SELECT SpanId FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE WHERE SessionId = '$2'"
}

metrics_has_run() {
  ct_output_holds "$2" \
    curl -fs --max-time 5 "http://127.0.0.1:$CT_CLAUDE_METRICS_PORT/metrics"
}

# grep against the file rather than a captured copy: this one grows to 64 MB
# before the exporter rotates it, and reading that into a shell variable sixty
# times over a poll would be the expensive way to ask a cheap question. -s
# because a missing file is the answer being computed, not a failure being
# hidden -- the enforcer below is what reports it, by name.
events_has_run() { grep -qsF -- "$2" "$CT_LOG_DIR/claude-events.jsonl"; }

# [LAW:one-type-per-behavior] Every sink is the same kind of thing: a place a
# signal lands, and a question whose answer means "this run's data is here". What
# differs is data, so the enforcer iterates this table and there is no per-sink
# code path. That is the property to keep: the next sink this stack grows should
# cost one row here, because a sink that arrives as its own bespoke check is a
# sink that starts drifting the day it lands.
#
# Fields: sink|holds-the-run|what a miss most likely means
ct_sinks() {
  cat <<'EOF'
jaeger|jaeger_has_run|The collector accepted the span, so its otlp_grpc/jaeger exporter or badger is what did not; jaeger.log has the storage side.
clickhouse|clickhouse_has_run|Likeliest cause is the exporter's INSERT no longer matching the table in config/clickhouse.yaml -- a collector upgrade that adds a column does exactly this; clickhouse.log has the rejection.
metrics|metrics_has_run|An empty scrape body means the metrics pipeline delivered nothing at all; a body naming other sessions means this run's metrics alone went missing.
events|events_has_run|The file/events exporter writes var/log/claude-events.jsonl directly, so an unchanged file means the logs pipeline itself is gone.
EOF
}

# Blocks until every sink holds the run, or dies naming the first that does not.
#
# [LAW:single-enforcer] One rule for four sinks: a run missing from any of them is
# a failed run. No sink carries its own patience or its own idea of how loudly to
# complain, so a fifth cannot arrive with a weaker standard than the four.
ct_await_run_in_every_sink() {
  local service="$1" needle="$2" sink holds hint
  while IFS='|' read -r sink holds hint; do
    ct_poll_until "$SINK_TIMEOUT_SECONDS" "$holds" "$service" "$needle" \
      || ct_die "the $sink sink never received this run.
  Waited ${SINK_TIMEOUT_SECONDS}s for session.id '$needle' under service '$service'.
  $hint
  Check: ./ct status, and $CT_LOG_DIR/collector.log"
    ct_ok "  $sink has it"
  done < <(ct_sinks)
}

# --- stage 2: the synthetic run ---------------------------------------------
# One payload per signal, each carrying the needle where that signal's sink will
# index it. Spelled out rather than generated from a common builder: an OTLP
# payload is the wire contract, and abstracting over the three shapes would hide
# exactly the differences that matter on the day one of them stops arriving.
#
# The span's ids are derived from the needle rather than drawn separately -- a
# uuid without its hyphens is exactly the 32 hex characters a trace id is -- so
# the run has one identity and no second random value to carry around.
# [LAW:one-source-of-truth]
#
# [LAW:effects-at-boundaries] These are pure: clock and network both live in the
# emitter, so a payload can be printed and read without sending anything.
otlp_attr() { printf '{"key":"%s","value":{"stringValue":"%s"}}' "$1" "$2"; }

selftest_span() {
  local needle="$1" now_ns="$2" trace_id
  trace_id="${needle//-/}"
  cat <<EOF
{"resourceSpans":[{"resource":{"attributes":[$(otlp_attr service.name "$SELFTEST_SERVICE")]},
"scopeSpans":[{"spans":[{"traceId":"$trace_id","spanId":"${trace_id:0:16}",
"name":"ct.selftest","kind":1,
"startTimeUnixNano":"$now_ns","endTimeUnixNano":"$((now_ns + 1000000))",
"attributes":[$(otlp_attr session.id "$needle")]}]}]}]}
EOF
}

selftest_metric() {
  local needle="$1" now_ns="$2"
  cat <<EOF
{"resourceMetrics":[{"resource":{"attributes":[$(otlp_attr service.name "$SELFTEST_SERVICE")]},
"scopeMetrics":[{"metrics":[{"name":"ct_selftest_runs","sum":{
"aggregationTemporality":2,"isMonotonic":true,
"dataPoints":[{"asInt":"1","startTimeUnixNano":"$now_ns","timeUnixNano":"$now_ns",
"attributes":[$(otlp_attr session.id "$needle")]}]}}]}]}]}
EOF
}

selftest_log() {
  local needle="$1" now_ns="$2"
  cat <<EOF
{"resourceLogs":[{"resource":{"attributes":[$(otlp_attr service.name "$SELFTEST_SERVICE")]},
"scopeLogs":[{"logRecords":[{"timeUnixNano":"$now_ns",
"body":{"stringValue":"ct.selftest"},
"attributes":[$(otlp_attr session.id "$needle")]}]}]}]}
EOF
}

# Fields: signal|payload
ct_selftest_signals() {
  cat <<'EOF'
traces|selftest_span
metrics|selftest_metric
logs|selftest_log
EOF
}

verify_transport() {
  local needle now_ns signal payload
  needle="$(ct_uuid)"
  now_ns=$(( $(date +%s) * 1000000000 ))

  ct_info "stage 2/3: synthetic traces, metrics and logs -> collector -> every sink"

  while IFS='|' read -r signal payload; do
    curl -fsS --max-time 5 -o /dev/null \
      -X POST "http://127.0.0.1:$CT_OTLP_HTTP_PORT/v1/$signal" \
      -H 'Content-Type: application/json' \
      -d "$("$payload" "$needle" "$now_ns")" \
      || ct_die "the collector refused an OTLP/HTTP $signal payload on port $CT_OTLP_HTTP_PORT"
  done < <(ct_selftest_signals)

  # The fan-out means one sink can fail while the others pass, which is the whole
  # point of having four -- and the reason each is a separate assertion rather
  # than a second guess at the first one.
  ct_await_run_in_every_sink "$SELFTEST_SERVICE" "$needle"
  ct_ok "  transport works: session.id '$needle' is queryable in all four"
}

# [LAW:verifiable-goals] Spans arriving is not the goal; spans you can group by
# the work they were doing is. Asking Jaeger's tag search -- rather than grepping
# the payload -- is deliberate: searchability is the property the labels exist
# for, and it is the one that would rot unnoticed. Rendering the query from the
# same table the stamp comes from is what makes it a check rather than a
# restatement: add, remove or rename a label and the expectation moves with it,
# because there is no second list here to forget.
claude_labels_searchable() {
  ct_output_holds "$1" jaeger_traces_tagged "$CLAUDE_SERVICE_NAME" \
    "$(ct_join_labels jaeger_tag_of),$(jaeger_tag_of session.id "$1")"
}

verify_claude() {
  local needle labels
  needle="$(ct_uuid)"
  labels="$(ct_work_labels)"

  ct_info "stage 3/3: real claude session -> collector -> every sink"

  # Run through the launcher rather than around it, so this stage covers the
  # path a real session takes -- labels included -- instead of a shortcut that
  # only resembles it. --session-id is what makes the run identifiable before it
  # has run: the needle stamped by hand in stage 2 is one Claude Code stamps on
  # every span, metric and event of this session, so the same four sink probes
  # answer for it. The prompt forces one tool call, so the probe exercises the
  # whole span shape we came for: interaction -> llm_request + tool ->
  # tool.execution.
  ( cmd_claude --session-id "$needle" \
      -p "Run the bash command \`echo $needle\` and reply with nothing else." \
      >/dev/null ) || ct_die "the claude probe run failed"

  ct_await_run_in_every_sink "$CLAUDE_SERVICE_NAME" "$needle"
  ct_ok "  a real claude session reaches all four sinks"

  # No polling here, and that is a claim rather than an omission: the sink check
  # above already found a span of this session in Jaeger, and the labels ride on
  # that same span's resource. If they are missing now they were never sent.
  # [LAW:no-ambient-temporal-coupling]
  claude_labels_searchable "$needle" \
    || ct_die "the session's spans arrived, but a tag search for the labels it was
  launched with did not find them: $labels
  One malformed entry makes Claude Code drop the whole set silently.
  Check: ./ct claude, which reports on stderr what it stamped."

  ct_ok "  work-unit labels are searchable: $labels"

  # [LAW:verifiable-goals] A row landing in ClickHouse is not the goal; a row
  # whose promoted columns are populated is. Those columns are extractions from
  # an attribute map, so a key Claude Code renames does not break anything
  # loudly -- it yields '' forever, and a column that is uniformly empty looks
  # identical to a column for something that never happened. By the time a query
  # returns a suspiciously round number, a year of history is already wrong.
  # So this asserts on the values, not the row count.
  # Polled, unlike the labels above: the sink check passed on whichever of this
  # session's spans arrived first, and the llm_request spans this asks about may
  # still be in the next export batch. [LAW:no-ambient-temporal-coupling]
  ct_poll_until "$SINK_TIMEOUT_SECONDS" clickhouse_returns_a_row \
    "SELECT Model, ContextTokens
       FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE
      WHERE SessionId = '$needle' AND SpanType = 'llm_request'
        AND Model != '' AND Repository != '' AND ContextTokens > 0
      LIMIT 1" \
    || ct_die "the probe session's promoted columns are empty.
  Its spans are in ClickHouse -- what failed is that SpanType, Model, Repository
  or ContextTokens came back empty on them. Compare the attribute keys on a live
  span against the MATERIALIZED expressions in config/clickhouse.yaml:
    ./ct sql \"SELECT SpanAttributes FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE WHERE SessionId = '$needle' ORDER BY Timestamp DESC LIMIT 1 FORMAT Vertical\""

  ct_ok "  spans are grouped by span type, session, model, repo and context size"

  # [LAW:verifiable-goals] Promoted columns being populated is not the goal
  # either; the tool-cost definition built on them holding is. That definition is
  # the one thing here that no sink check can catch, because it fails by going
  # quiet: it reads stop_reason and the order of requests under a parent, so a
  # renamed value or a reparented span takes out two of ServesToolCall's three
  # clauses. Not the third -- RequestContext reads a different attribute key
  # entirely and goes on marking every subagent request -- so what comes back is
  # not a zero anyone would question but a large, plausible undercount. That is
  # the harder failure to spot, not the easier one, which is the whole reason
  # this assertion exists.
  #
  # The probe prompt forces one tool call, so this session must contain the
  # pairing the definition is made of: a request that ended in tool_use, and the
  # request after it carrying the result back. Asserting ToolResultTokens > 0 is
  # what makes it a check on the pairing rather than on the flag -- the flag can
  # be true by accident, but a positive context delta means two specific rows were
  # matched to each other correctly.
  ct_poll_until "$SINK_TIMEOUT_SECONDS" clickhouse_returns_a_row \
    "SELECT ToolResultTokens
       FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_REQUESTS_VIEW
      WHERE SessionId = '$needle' AND ServesToolCall
        AND CarriesToolResult AND ToolResultTokens > 0 AND TotalTokens > 0
      LIMIT 1" \
    || ct_die "the probe session made a tool call, but
  $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_REQUESTS_VIEW cannot see it. The view
  pairs each llm_request with the one before it under the same parent span; that
  pairing is what attributes tokens to tool usage, and nothing else in this stack
  would notice it breaking.
  Compare what the probe actually emitted against what the view expects:
    ./ct sql \"SELECT Timestamp, SpanId, ParentSpanId, StopReason, RequestContext, ContextTokens, OutputTokens FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE WHERE SessionId = '$needle' AND SpanType = 'llm_request' ORDER BY Timestamp FORMAT PrettyCompact\"
  A StopReason that is no longer 'tool_use', or an llm_request no longer sharing a
  parent with its neighbours, is the definition in config/clickhouse.yaml going stale."

  ct_ok "  tokens are attributable to tool usage: the request pairing holds"
  echo
  ct_trace "http://127.0.0.1:$CT_JAEGER_UI_PORT/search?service=$CLAUDE_SERVICE_NAME&operation=claude_code.interaction"
  ct_trace "./ct sql \"SELECT Model, sum(OutputTokens) FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_TABLE GROUP BY 1 FORMAT PrettyCompact\""
  ct_trace "./ct sql \"SELECT sumIf(TotalTokens, ServesToolCall) FROM $CT_CLICKHOUSE_DATABASE.$CT_CLICKHOUSE_REQUESTS_VIEW WHERE toYYYYMM(Timestamp) = 202603\""
}

cmd_verify() {
  verify_labels
  verify_transport
  verify_claude
}

# --- dispatch ---------------------------------------------------------------

# The header block is the only copy of the command list; usage reads it back
# rather than restating it. Ending the range at the first blank line, instead of
# a line number, is what keeps that true when a command is added.
usage() {
  sed -n '3,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  up)     cmd_up ;;
  down)   cmd_down ;;
  status) cmd_status ;;
  logs)   cmd_logs ;;
  ui)     cmd_ui ;;
  env)    cmd_env ;;
  verify) cmd_verify ;;
  sql)    shift; cmd_sql "$@" ;;
  claude) shift; cmd_claude "$@" ;;
  *)      usage; exit 1 ;;
esac
